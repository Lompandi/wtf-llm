# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

.vs
src/wtf/fuzzer_*
# The shared placement/resolution header is copied into src/wtf/ at build time by
# fuzzer/build.py, for the same reason the modules are: the compiler resolves
# #include relative to the STAGED .cc. Its tracked home is fuzzer/module/.
src/wtf/snapfuzz_resolve.h
# Same for the generated struct headers. fuzzer/build.py stages every *.h from
# fuzzer/module/, so anything added there arrives here too -- and a build product
# tracked in git is D-012 in the other direction: the copy starts drifting from the
# original and it is not obvious which one the compiler read.
src/wtf/generated_input*.h
src/build/
src/build_msvc/
src/out
targets/

# --- snapfuzz (CLAUDE.md section 5) ---
# NOTE: `src/wtf/fuzzer_*` above is upstream's and is deliberately left alone.
# It means our CP4 module must NOT live at src/wtf/fuzzer_snapfuzz.cc as its
# home -- git would silently ignore it. The source of record is
# fuzzer/module/; fuzzer/build.py copies it into src/wtf/ at build time, where
# being ignored is correct. See docs/DEVIATIONS.md D-012.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# SECRETS. The LLM token lives here and must NEVER be committed
# (CLAUDE.md section 7.1, section 10). config/llm.yaml holds the base URL and
# model routing; the token is read from the environment only.
.env
.env.*
!.env.example

# Generated pipeline artifacts (A1-A5) and logs.
artifacts/
logs/

# Fetched by tools/bootstrap.py: Ghidra is ~550 MB zipped, 872 MB extracted, and
# byte-identical for everyone. The bootstrap verifies its sha256 and records the
# path in config/target.yaml, so a clone stays small and still needs no manual
# configuration. Commit it deliberately if an offline machine needs it.
third_party/

# Internal design, spec and progress documents. This is a tool; the spec, the gate
# scorecard, the deviation log and the measured results are how it was built, not
# how it is used. Tests that assert against them skip when absent
# (tests/gates/conftest.py::read_internal_doc), so a clone's suite stays green.
#
# docs/evidence-manifest.json is deliberately NOT here: it is a list of artifact
# hashes whose entire purpose is to be committed, so untracking it would remove the
# thing it exists to provide (D-069). It contains no design narrative.
CLAUDE.md
docs/PROGRESS.md
docs/DEVIATIONS.md
docs/DECISIONS.md
docs/RESULTS.md
docs/ENVIRONMENT.md
snapfuzz_code_review_recommendations.md
snapfuzz_new_review_fixes.md
# Any further review write-ups: same category, and the first one was deleted
# from the remote by hand rather than caught by a pattern.
snapfuzz_*review*.md

# A second real target: a 4.1 GB mem.dmp plus its exe. Same reason as
# targets/*/state/mem.dmp -- hashes travel in git, gigabytes do not (D-069).
fuzzing-snapshot-2/

# The downloadable data package. A build product: rebuilt from docs/figures/ and
# artifacts/runs/ by the commands in its own MANIFEST.json, so tracking it would put a
# stale copy of committed data in git.
snapfuzz-cp10-data.zip
snapfuzz-benchmarks.zip

# The third target's snapshot: a 3.76 GB dump, supplied rather than produced here.
fuzzing-snapshot-3/
fuzzing-test-cmp.zip
